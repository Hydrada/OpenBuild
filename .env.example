# Leave DATABASE_URL unset to use the embedded PGlite database in PGLITE_DIR.
DATABASE_URL=postgres://openbuild:openbuild@localhost:5432/openbuild
PGLITE_DIR=./data/pglite
PORT=3000
HOST=127.0.0.1
# Set to false after creating your organization on a shared server.
OPENBUILD_ALLOW_SIGNUP=true
# Set to true when served over HTTPS.
OPENBUILD_SECURE_COOKIES=false
